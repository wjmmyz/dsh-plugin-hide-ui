{
  "name": "@wjmmyz/dsh-plugin-hide-ui",
  "version": "1.0.1",
  "description": "Hide the Plugins entry in the DSH sidebar and the built-in agent presets in the preset pickers.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjmmyz/dsh-plugin-hide-ui.git"
  },
  "homepage": "https://github.com/wjmmyz/dsh-plugin-hide-ui#readme",
  "bugs": {
    "url": "https://github.com/wjmmyz/dsh-plugin-hide-ui/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-agent-preset"
      ]
    }
  }
}
